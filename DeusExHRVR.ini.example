[VR]
; Walking input response: 0 = Normal (default), 1 = Gentle, 2 = Gentler.
; Gentler spreads moderate input across the middle stick range, rising to full output near the edge.
; Gentle reduces partial locomotion input after native deadzone processing,
; preserving direction and full-deflection input. Requires MotionControls.
; Also adjustable in VR Settings with Save & Back; menus remain unchanged.
MovementResponse=0
; Copy this file to DeusExHRVR.ini beside DXHRDC.exe. Keep the [VR] section.
; Restart the game after editing; this setting applies to tracked VR.
; Higher values = smaller apparent world, stronger close-range stereo depth.
; Lower values = larger apparent world, weaker close-range stereo depth.
; Also scales physical head/hand translation and apparent hands/weapons.
; Default 300. Accepted range 10-1000 is not a tested comfort range.
; VR Settings applies changes on Save & Back, then resume; no restart needed.
WorldUnitsPerMetre=300

; Optional: keep mouse/gamepad aiming pitch out of the VR camera.
; The gun still aims vertically; headset pitch and horizontal look remain free.
; Virtual-screen modes retain the native camera. Restart to apply.
LockVerticalCamera=0

; Motion-sickness fixes for the walk/equip animation reaching the VR view.
; The game composes its camera from an animated skeleton. When the save's own
; look angle is steep, the heading taken from that camera becomes very
; sensitive to small rotations and the animation shows up as the whole scene
; swaying. These three take the view from the aiming state instead, before the
; animation is applied. All require MotionControls and YawOnlyCamera, apply
; only in normal gameplay with the player's own camera, and switch themselves
; off on a game build they do not recognise. Restart to apply.
;
; Zero the native aiming pitch, so the heading stays well conditioned.
NativeLookPitchLock=0
; Take the VR heading from the aiming yaw rather than the animated camera.
NativeLookHeading=0
; Take the VR camera's horizontal position from the player's own position,
; discarding the animation's sideways offset. Needs NativeLookHeading.
NativeCameraPosition=0
; Safety limit on NativeLookHeading, in degrees (default 5). The aiming yaw replaces the
; camera's heading only while the two still agree about where you are facing.
; A scripted third-person shot - a takedown, Icarus, Typhoon - swings the camera
; away from your body on a frame that still looks like ordinary gameplay to
; every other guard, and the substitution then lands a heading tens of degrees
; from the scene you are looking at. Past this limit the frame is left alone and
; counted as 'rejected' in DeusExHRVR-camera.log; NativeCameraPosition stands
; down with it. Because such a shot ENDS by swinging the camera back onto your
; body, the disagreement sweeps down through the limit rather than stopping at
; it, so the rejection latches: once out it stays out until the two headings
; agree within 2 degrees for a continuous 250 ms. Ordinary play sits at about
; 0.1 degrees and peaks near 1.2, so the limit never binds during normal
; movement and the latch clears immediately. 0 disables both and always
; substitutes, the behaviour before October 20, 2026. Restart after changing it.
NativeLookHeadingMaxDeg=5

; Master switch for ALL right-controller features. 0 disables controller
; tracking, Xbox button emulation, weapon motion, and controller directions.
; Headset VR and Headset direction settings still work. Restart to apply.
MotionControls=1
; Optional full-headset scope with right-controller aiming; requires weapon motion.
; Also available in VR Settings > View > Immersive scope.
ImmersiveScope=0
; Scope zoom, 1-12. The VR settings menu (Scope zoom) offers 3-12: below 3 the
; game's black scope surround leaves the edges of the view uncovered.
ScopeMagnification=4

; Left thumbstick click waits this long (ms) before a hold registers, so the
; two-stick weapon calibration chord doesn't also crouch. 0 sends it at once,
; for layouts that map the left click to something other than crouch.
LeftStickClickDelayMs=150

; Independent directions: Mouse, Headset, or Controller (right-hand aim).
; Mouse retains native mouse/gamepad look direction. Restart after editing.
; Interaction selects doors/items; it does not change weapon aiming.
InteractionAim=Mouse
; Thrown grenades: Controller (default) throws where your right hand points,
; so pointing higher throws farther. Headset throws where you look,
; LeftController follows the left hand, and Mouse keeps the game's own throw
; along the camera's facing. Only the direction changes; throw strength,
; release point and gravity stay the game's. Each throw writes one line to
; DeusExHRVR-throw.log. Restart after editing.
; Also available in VR Settings > Controls > Grenade aim.
ThrowAim=Controller
; Landing marker: hold the throw button and, after its hold delay (RightAHoldMs
; for a throw on right A), a ring shows where the grenade should first hit;
; let go to throw. A quick press throws at once as before. The point uses the
; game's own throw setup and collision; the game's small random spread is not
; shown, and the ring is not hidden by things in front of it. 0 turns it off
; and restores press-to-throw. Restart after editing.
; VR Settings > Controls > Grenade landing ring (inactive with default game aim).
ThrowMarker=1
; Rockets (and any other gun whose shot is a flying object): 1 (default)
; fires them straight along the gun barrel in your hand. 0 keeps the game's
; own aim, toward where the body faces. Only the direction changes; speed,
; spread, damage and the explosion stay the game's. Each shot writes one line
; to DeusExHRVR-projectile.log. Restart after editing.
ProjectileAim=1
; Walking uses horizontal heading only, including W/A/S/D and gamepad movement.
; MovementDirection also accepts LeftController (left-hand aim). Controller
; retains its existing right-hand meaning; RightController is an alias.
; The VR menu offers Head, Left hand and Right hand with Save / Discard.
MovementDirection=Mouse
; Screen modes and missing tracking fall back to Mouse. Controller choices
; also work with ExperimentalMotionControls=0 and with the gun holstered,
; provided MotionControls=1. MotionControls=0 makes Controller use Mouse.

; Experimental right-controller weapon pose. Xbox button emulation works independently.
; Automatically falls back in screen modes or when controller tracking is lost.
ExperimentalMotionControls=0
; Hide the player's actor/arms mesh during controller aiming (experiment only).
ControllerHideArms=1
; Position the muzzle this far ahead of the controller aim pose (0-1 metre).
ControllerMuzzleForwardMetres=0.25

; Draw Jensen's hands at your controllers instead of the arms the game
; animates, carrying an equipped weapon with the right hand. Needs
; ExperimentalMotionControls=1. Mode 15 with model alignment takes the hand
; position from the player model's own skeleton, so no calibration is needed;
; this is the combination the installed configuration uses and the only one
; that is tested. See the README for what happens in cover and on an
; unrecognised player model. Restart to apply.
ControllerHands=0
ControllerHandsMode=0
ControllerHandsModelAlignment=0
; Carry an equipped weapon with the hand.
ControllerHandsWeapon=0
; Draw the left hand too. Needs the companion that carries its pose.
ControllerHandsLeft=1
; Hold the wrist at the model's resting angle instead of letting the game's
; animation move it, which otherwise wiggles while sprinting and sits at a
; different angle per weapon.
ControllerHandsNeutralWrist=1
; Visual-only finger closing with an empty hand. Uses remapped VR input and only
; a fully holstered weapon state. Enabled by default; set 0 to turn it off. Restart
; after changing. No calibration or pose capture.
ControllerHandsInteractCurl=1
; Fingers on both hands follow how far you squeeze the grip. 0 returns to the
; earlier gentle right-hand curl on Interact. Restart after editing.
HandGripClose=1
; Forgiving interaction aim: the game also considers the usable object closest to
; your aim, and a prompt stays through small hand movements. The game's own range and
; rules still apply. Needs InteractionAim=Controller. 0 turns it off. ForgivingAimDegrees
; is the width of the cone around the aim line. ForgivingAimLog=1 writes troubleshooting
; lines to DeusExHRVR-interaction-path.log, replaced at each launch. Restart after editing.
ForgivingAim=1
ForgivingAimDegrees=15
ForgivingAimLog=0
; The game is asked about the chosen item from your headset, then from your hand, so its
; visibility check matches what you can see. 0 asks only from the hand. Your hand still
; chooses the item. Restart after editing.
InteractionFromEye=1
; Interaction line from the visible hand: an empty hand points from the palm along the
; fingers, tilted InteractionHandTiltDegrees toward the palm (-30 to 60, default 15). A
; hand holding a gun points along the barrel. Needs ForgivingAim=1. InteractionFromHand=0
; goes back to the controller's aim direction. Restart after editing.
InteractionFromHand=1
InteractionHandTiltDegrees=15
; Hand pointers: a ring where each hand's interaction line lands, cyan for the right hand
; and amber for the left. Off (default), Right, Left or Both. VR Settings > Controls > Hand pointers.
HandPointers=Off
; Hand contact: a usable item within HandContactCm of either hand (5 to 40, default 15) is
; selected whichever way the hand points, nearest first, so you can pick items out of a
; crowded locker. Everything farther away uses forgiving aim. Needs InteractionAim=Controller.
; 0 turns it off. HandContactExact=1 adds surface searches for long items, with a small
; weight for distance to the item's center. 0 uses center distance only.
; HandContactThroughItems=1: when another usable item (an open locker door, a neighbour)
; is in the line to the item under your hand, the game's line is cast again ignoring it,
; and only a real hit on your item counts. Walls still stop the line. It can also pass
; a closed door, since doors are usable items. 0 turns it off. Needs HandContactExact=1.
; Restart after editing.
; Experimental hand nudges: an empty hand moving into a box, barrel or dumpster pushes
; it, like walking into it does. No grip press needed. Off by default; restart after changing.
HandPush=0
; Size of the search around each hand, in cm (3 to 20). Restart after editing.
HandPushCm=8
; Push strength: 1 matches the most the game's own walk push uses (0.25 to 4).
; Raise it if light objects need too much effort. Restart after editing.
HandPushStrength=1
; Instant shove: the moment a hand touches an object, the object takes the hand's
; sideways speed (light objects about the same speed, a dumpster about a fifth), using
; the same game call a throw uses. 0 turns it off. Restart after editing.
HandPushShove=1
; Diagnostic log DeusExHRVR-hand-push.log (at most 6000 lines: a summary each second,
; hand lines while touching something pushable, and whether pushed objects moved).
; 0 (default) turns it off. Restart after editing.
HandPushLog=0
; Observation only: what the game's own walk-into-object push does (what it finds and
; how hard it pushes, and each walked-into object's speed frame by frame for 0.6 s).
; Writes DeusExHRVR-body-push.log (at most 4000 lines). Never pushes.
; 0 (default) turns it off. Restart after editing.
BodyPushLog=0
HandContactInteract=1
HandContactExact=1
HandContactThroughItems=1
HandContactCm=15
; 1 writes DeusExHRVR-interaction-timing.log: one summary a second of interaction work,
; plus carry start and end and when the carried-throw code runs, replaced each launch. 0 (default) writes nothing. Restart to apply.
InteractionTimingLog=0
; Either hand can interact: while your left hand has the prompt, left grip acts as
; Interact. 0 keeps interaction on the right hand. LeftHandCarryThrow=1 moves the throw
; to the left trigger when the left hand is carrying a body or object. Restart after
; editing.
LeftHandInteract=1
LeftHandCarryThrow=1
; Boxes and carried bodies throw along the controller aim of the hand that grabbed them.
; Uses the game's normal strength, not controller swing speed. Needs motion controls and
; ForgivingAim=1 for grab ownership. Tracking loss falls back to the native camera direction.
; 0 restores native carried-object direction. Grenade ThrowAim is separate. Restart to apply.
CarriedThrowAim=1
; Carried objects retain their picked surface at the grabbing palm. Bodies use the
; hand as their drag target. CarriedItemHandCm (0 to 40, default 3) is the rigid
; object's surface gap; it does not offset body dragging. Missing surface data
; uses a fixed palm offset. CarriedItemAtHand=0 disables both. Restart to apply.
CarriedItemAtHand=1
; Experimental; 0 keeps existing placement, 1 attaches surface and wrist rotation.
CarriedAttachment=0
; Suppress the native held-object fade only in attachment mode; 0 keeps it.
CarriedOpaque=1
CarriedItemHandCm=3
; Which camera modes the hands step aside for, as a bit mask over the game's
; modes. 342 = cover, ladders, the animation-bone camera, lying down, orbit.
ControllerHandsSuspendModes=342
; Older measured paths, superseded by model alignment and not recommended.
ControllerHandsPose=0
ControllerHandsCalibrate=0
ControllerHandsArmGestureMs=1500
; Learn and store a per-weapon grip offset, adjusted by a two-thumbstick
; gesture in game. This has NO EFFECT while ControllerHands=1: the weapon's own
; grip, read from the game's animation, replaces a stored offset rather than
; adding to it. Only useful with the hands off.
WeaponCalibration=1

; Keep only heading (yaw) from the head pose captured when tracking starts and
; on F9, so a head tilted up or down at that moment does not tilt the world.
; Position, including height, is still captured. 0 restores the old behavior.
LevelRecenter=1
; The view freezes while the in-game menu (map, objectives, inventory) or a
; loading screen is up. Keep only the heading of that frozen pose so the screen
; is level instead of tilted with the head. 0 restores the old behavior.
LevelMenu=1
; Place the virtual screen (title and pause menus, terminals, videos) upright,
; 2 m straight ahead at head height, instead of tilted with the head.
; 0 restores the old behavior.
LevelScreen=1

; Take the VR rendering base from the game camera's heading and position only:
; the headset supplies all pitch and roll, including the walk animation's tilt.
; Aiming, the gun and virtual-screen modes are unaffected. Restart to apply.
YawOnlyCamera=0

; HUD: 1 shows the game's HUD on your hands and wrist; 0 keeps the game's own
; HUD on the screen. Also in the VR settings menu (HUD: DEFAULT / HANDS), where
; a change applies as soon as it is saved.
HandHud=1
; Cover: 1 (default) swings the cover camera around Jensen to follow where your
; right hand aims, left-right and up-down, once the aim moves past a small dead
; zone, as the mouse does. The gun stays in Jensen's hands and aims where the
; controller points. 0 keeps the cover camera still. Needs MotionControls=1.
; Restart after editing.
; VR Settings > View > Cover camera; applies when saved.
CoverCameraFollow=1
; VR crosshair at the point your shot would hit: Off, FirstPerson, ThirdPerson
; (cover, the default) or Both. While it shows, the game's own crosshair is hidden.
; Off also hides the game's crosshair in cover, where it would mark the camera's
; aim rather than the controller's. VR Settings > View > Crosshair; applies when saved.
Crosshair=ThirdPerson
; Keeps the view below low ceilings such as vents while crouched, including when your
; real head is higher than when you recentered. 0 turns it off. CeilingGuardCm is the
; gap to keep (3 to 40). CeilingGuardLookAhead=1 starts easing down just before you
; reach a low ceiling; 0 turns that part off. Restart after editing.
CeilingGuard=1
CeilingGuardCm=20
CeilingGuardLookAhead=1
; Two-handed weapons: hold the left grip with your left hand near the weapon and it
; takes the game's own grip pose (the PEPS and stun gun stay one-handed). While it holds the weapon, left grip does not send
; its normal action (sprint on the default layout). 0 turns it off. TwoHandedAim=1 lets the left hand
; steer the barrel while it holds the weapon; 0 leaves aiming on the right hand.
; TwoHandedWeaponsLog=1 writes DeusExHRVR-twohand.log for troubleshooting. Restart
; after editing.
; Sprint cancels the hold and two-handed aim; release and re-press grip after sprint.
TwoHandedWeapons=1
TwoHandedAim=1
TwoHandedWeaponsLog=0
; EXPERIMENTAL left-handed mode, stage 1 (hands). 1 mirrors the hands: Jensen's left
; hand holds at the left controller, posed as the mirror image of his right hand, and his
; right hand rests at the right controller. Not yet mirrored: the gun itself, the wrist
; HUD sides. Two-handed weapons are off while it is on. For firing with the left
; trigger, add to [Buttons]: LeftTrigger=RT and RightTrigger=LT. 0 (default) turns it off.
LeftHanded=0
; Diagnostic log DeusExHRVR-left-handed.log (mirrored/failed hand poses every 2 s, at
; most 400 lines). 0 (default) turns it off.
LeftHandedLog=0
; EXPERIMENTAL first-person takedowns, off by default. Set FirstPersonTakedowns=1 to try
; them. The game's animation still runs. Your view rides along with Jensen's eyes and turns
; with his body, and only his arms are shown. It can cause motion sickness, the view can
; clip through characters, and hands can be missing. While it is on, each takedown is
; written to DeusExHRVR-takedown.log; FirstPersonTakedownsLog=0 stops that. Restart after
; editing.
FirstPersonTakedowns=0
FirstPersonTakedownsLog=1
; The game's quickbar: 1 auto-hides it, 0 keeps it on screen. Leave this line out to
; let the game decide. VR Settings > Controls > Quickbar; the tilde key also changes it.
; QuickBarAutoHide=1
; Headset image, -50 to 50 in steps of 5. 0 is the game's original image.
; Also at VR Settings > Image.
Brightness=0
Contrast=0
; EXPERIMENTAL, USE AT YOUR OWN RISK. Multiplies the resolution your VR runtime asks for
; (1.0 to 2.0). Costs far more GPU power: 1.25 is 56% more pixels, 1.5 is 125% more.
; This 32-bit game can stutter, run out of memory or crash at higher values. If it
; does, set this back to 1.0. Restart the game after editing. Not in the VR menu.
ExperimentalRenderScale=1.0
; Keep the view at Jensen's eyes during conversations instead of following the
; game's shot cuts between the NPC and Jensen; turn your head to look around.
; Jensen's own model is hidden while the view is held. Restart to apply.
FixedDialogueCamera=0

; Take the camera height from the player's own origin plus a held eye height,
; instead of following the game camera. Removes the walk bounce and the stance
; height steps the game applies while crouch-walking (+15 units) and sprinting
; (-25), which show up as a bounce when you stop. Restart to apply.
StanceHold=0
; Gap that counts as a real stance change, in game units. Crouched and standing
; differ by about 300; gait offsets are 15-25 and walking bob is about 2.
; The view drops or rises through a real crouch or stand at the game's own
; transition speed.
StanceHoldTrigger=60

; Optional: keep the camera on the player's own path instead of following the
; run animation's side-to-side sway (about 1 cm, once per step). The value is
; the averaging window in milliseconds; 667 is one running stride. 0 disables.
SideSwayHoldMs=0

; Optional stutter fix from HRDCfix (github.com/imring/HRDCfix): a wait loop
; in the game sleeps a whole Windows timer tick (~15 ms) at a time; 1 makes it
; only yield instead. Needs no ASI loader when applied here.
SleepFix=0

; Optional filtering of the walk animation's left-right heading swing, in
; milliseconds; 0 disables each stage. Two cascaded stages (walking, then a
; second rhythm for sprinting). Needs YawOnlyCamera=1 to take effect.
; Suggested values: 667 / 526. Snap turns and other jumps pass through.
HeadSwayYawMs=0
HeadSwayYawMs2=0
; Largest heading correction allowed, in degrees.
HeadSwayYawLimit=1.5
; Write DeusExHRVR-bob.csv, one line per frame (camera position and heading,
; stick input, head pose) for measuring the walk animation. Costs frame time;
; leave at 0 for play.
BobTrace=0
; Write the interaction targeting samples to DeusExHRVR-interaction.log:
; what the aim ray was, which candidates the game offered and how far away
; they were. At most 300 samples, no oftener than one every two seconds.
; Installs two extra native probes while on; leave at 0 for play.
InteractionDiagnosticLog=0
; Optional hand mesh/draw/muzzle diagnostics. Collection and background flush
; are disabled at 0. Rendering, validation and calibration remain functional.
HandDiagnosticLog=0
; Periodic controller status and native-pair transition observations.
RuntimeDiagnosticLog=0
; Developer-only live polling of hand INI settings. Normally read at startup.
; Does not affect live changes made through the VR settings menu.
HandConfigLiveReload=0
; MovementResponseLog is retired; walking-response diagnostics were removed.

; Snap turn: a horizontal right-stick flick turns the view instantly during
; gameplay instead of the stick's accelerating smooth turn. Menus, terminals
; and scoped aiming keep the native right stick.
SnapTurn=0
SnapTurnDegrees=30
; Legacy serialization/rollback value; direct snapping does not use mouse counts.
SnapTurnMouseCounts=300
; Legacy option, unused by direct snapping. Left-stick movement is not paused.
SnapTurnPauseMs=60
; Legacy option, unused by direct snapping. Quickbar settings are left alone.
SnapTurnHideQuickBar=1
; RightStickUp and RightStickDown under [Buttons] hold a target while the right
; stick is pushed up or down during gameplay. With SnapTurn=0, setting either one
; takes the stick's vertical axis for them; smooth turning keeps the horizontal.

; Optional button layout. [Buttons] applies to gameplay and scoped aiming,
; [ScreenButtons] to everything else: the title and pause menus, the in-game
; menu (map, objectives, inventory), the e-reader and news reader, terminals,
; hacking, videos, game over and loading screens.
; Omitted entries keep the stock layout. Inputs: RightA, RightB, LeftX, LeftY,
; LeftGrip, RightGrip, LeftStickClick, RightStickClick, LeftTrigger,
; RightTrigger. Targets: A B X Y LB RB LS RS LT RT Back Start DPadUp DPadDown
; DPadLeft DPadRight QuickSave None. QuickSave presses F5, the game's quicksave
; key, which has no gamepad binding. <Input>HoldMs=250 delays the target until
; the input has been held that long; with a delay set, <Input>Tap=A sends a short pulse
; when the input is released early.
[Buttons]

[ScreenButtons]
[Luma]
; Native Luma-shader port (sidesteps ReShade). Loads a hash-keyed shader
; replacement table from DeusExHRVR/shaders/dxhr/table.csv. Set to 0 to
; disable the whole subsystem; a missing or empty table is harmless.
; Match logging is always on when Enable=1; see DeusExHRVR-shaderswap.log.
Enable=1
; Actual pixel-shader substitution. Off by default for safety — flip on only
; after confirming (via the match log) that hashes resolve against the live
; game. F12 toggles this live without restarting. Substituted shaders are
; logged to DeusExHRVR-shaderswap.log and counted in the F8 camera log as
; 'substitutions='. Restart the game after changing this ini value.
SubstituteShaders=0

; Phase 3 — injected render passes (per-eye, sidesteps ReShade). All default
; off; enable individually after confirming the trigger hashes match. Counts
; appear in the F8 camera log as 'lumaPasses xegtao=N smaa=N modulate=N'.
; Restart the game after changing these.
; Native game ambient occlusion is retained; the XeGTAO experiment was withdrawn.
; SMAA: subpixel morphological AA replacing the game's MLAA. Phase 3e (stub —
; trigger detection only; full draw passes land in a later commit).
SMAAEnable=0
; ModulateLighting: adjust the completed lighting buffer before materials
; sample it, separately for each eye.
ModulateLightingEnable=0

; LumaSettings cbuffer values. These are passed to Luma's replacement + injected
; shaders at b13. Defaults match Luma's DXHR "not vanilla like" tuned values
; (main.cpp lines 1589-1599). Override to taste; restart to apply.
BloomIntensity=0.8
FogIntensity=0.0
ColorGradingIntensity=1.0
DesaturationIntensity=0.333
AmbientLightingIntensity=0.8
EmissiveIntensity=0.667
HDRBoostIntensity=1.0
; RGB multipliers; 1 is neutral. Lighting* requires ModulateLightingEnable=1.
LightingRed=1.0
LightingGreen=1.0
LightingBlue=1.0
AmbientRed=1.0
AmbientGreen=1.0
AmbientBlue=1.0

; Phase 4: overlap dedup. When on (default), Luma substitution is skipped for
; shaders DXHRVR already corrects per-eye (projected light/shadow via F3,
; identified at runtime via EffectShader::UsesCentreViewMatrix). Luma's mono
; replacements might not respect DXHRVR's per-eye transforms, so skipping
; avoids potential stereo conflicts. Also auto-skips Luma's SSAO generation
; replacement when XeGTAO is enabled (XeGTAO overwrites the result). Skipped
; hashes are logged to DeusExHRVR-shaderswap.log. Set to 0 to force Luma
; substitution everywhere (for testing).
DedupWithDXHRVR=1
